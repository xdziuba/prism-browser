# Prism-owned package identity for ordinary unbranded Linux builds.
PACKAGE="prism-browser"
PROGNAME=chrome
INSTALLDIR=/opt/prism-browser
ENROLLMENTDIR=/etc/prism-browser/policies/enrollment
MENUNAME="Prism Browser"
SHORTDESC="Prism Browser, a Chromium-based developer browser"
FULLDESC="Prism Browser is an open-source developer browser built on Chromium."
MAINTNAME="Prism Browser contributors"
MAINTMAIL="xdziuba@users.noreply.github.com"
PRODUCTURL="https://github.com/xdziuba/prism-browser"
PROJECT_LICENSE="BSD-3-Clause and LGPL-2.1+ and Apache-2.0 and IJG and MIT and GPL-2.0+ and ISC and OpenSSL and (MPL-1.1 or GPL-2.0 or LGPL-2.0)"
DEVELOPER_NAME="Prism Browser contributors and The Chromium Authors"
BUGTRACKERURL="https://github.com/xdziuba/prism-browser/issues"
HELPURL="https://github.com/xdziuba/prism-browser"
RDN="io.github.xdziuba.PrismBrowser"
URI_SCHEME="x-scheme-handler/prism-browser;"
