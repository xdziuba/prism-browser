{
  "manifest_version": 3,
  "name": "Prism Media Controls",
  "version": "0.1.0",
  "key": "",
  "incognito": "not_allowed",
  "permissions": ["storage", "declarativeNetRequest"],
  "options_page": "settings/media_controls.html",
  "background": {
    "service_worker": "component/worker.mjs",
    "type": "module"
  },
  "content_scripts": [{
    "matches": [
      "https://youtube.com/*",
      "https://www.youtube.com/*",
      "https://m.youtube.com/*",
      "https://music.youtube.com/*"
    ],
    "js": ["component/content_script.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": [
      "media/watch_playback_session.mjs",
      "media/playback_controls.mjs",
      "media/playback_controller.mjs",
      "media/segment_policy.mjs",
      "media/youtube_site_adapter.mjs"
    ],
    "matches": [
      "https://youtube.com/*",
      "https://www.youtube.com/*",
      "https://m.youtube.com/*",
      "https://music.youtube.com/*"
    ]
  }]
}
