+#if BUILDFLAG(IS_LINUX)
+  // GTK paints its own headerbar color over the ColorProvider frame. Cover
+  // only the interior of Prism's ordinary frame, leaving native frame edges,
+  // image themes, and special windows to their existing paint paths.
+  const bool prism_frame_color =
+      frame_color == SkColorSetRGB(0x1C, 0x29, 0x32) ||
+      frame_color == SkColorSetRGB(0xE2, 0xEB, 0xF0);
+  if (prism_frame_color && GetBrowserView()->GetIsNormalType() &&
+      GetFrameImage().isNull()) {
+    const gfx::Insets border = FrameBorderInsets(false);
+    canvas->FillRect(
+        gfx::Rect(border.left(), border.top(),
+                  width() - border.left() - border.right(),
+                  GetTopAreaHeight() - border.top()),
+        frame_color);
+  }
+#endif
