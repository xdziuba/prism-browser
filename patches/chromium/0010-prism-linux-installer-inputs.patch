 branding_dir_100 =
     "//chrome/app/theme/default_100_percent/$branding_path_component"
+if (is_prism_linux) {
+  branding_dir = "//chrome/app/theme/prism"
+  branding_dir_100 = "//chrome/app/theme/default_100_percent/prism"
+}
 
 copy("common_packaging_files") {
   visibility = [ ":*" ]
@@ -373,6 +383,8 @@ copy("common_packaging_files") {
 
   if (is_chrome_branded) {
     sources += [ "common/google-chrome.info" ]
+  } else if (is_prism_linux) {
+    sources += [ "prism/chromium-browser.info" ]
   } else {
     sources += [ "common/chromium-browser.info" ]
   }
@@ -458,9 +470,13 @@ if (!is_chromeos) {
 process_version("save_build_info") {
   # Just output the default version info variables (no template).
   process_only = true
+  installer_branding_file = branding_file_path
+  if (is_prism_linux) {
+    installer_branding_file = "$branding_dir/BRANDING"
+  }
   sources = [
     "//chrome/VERSION",
-    branding_file_path,
+    installer_branding_file,
     lastchange_file,
   ]
   output = "$root_out_dir/installer/version.txt"
@@ -564,6 +580,8 @@ template("linux_package") {
 
   if (is_chrome_branded) {
     package = "google-chrome"
+  } else if (is_prism_linux) {
+    package = "prism-browser"
   } else {
     package = "chromium-browser"
   }
