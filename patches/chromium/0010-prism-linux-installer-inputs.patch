+is_prism_linux = !is_chrome_branded && !is_chrome_for_testing
+assert(!is_prism_linux || !enable_flatpak,
+       "Prism Flatpak identity requires a separate installer change")
+
 if (current_cpu == "x86") {
   deb_arch = "i386"
   rpm_arch = "i386"
@@ -321,6 +325,8 @@ action("deb_repo_package") {
 
   if (is_chrome_branded) {
     package = "google-chrome-repo"
+  } else if (is_prism_linux) {
+    package = "prism-browser-repo"
   } else {
     package = "chromium-browser-repo"
   }
@@ -348,6 +354,10 @@ action("deb_repo_package") {
