+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+void AddPrismChromeColorMixer(ui::ColorProvider* provider,
+                              const ui::ColorProviderKey& key) {
+  using ThemeType = ui::ColorProviderKey::ThemeInitializerSupplier::ThemeType;
+  if ((key.custom_theme &&
+       key.custom_theme->get_theme_type() != ThemeType::kNativeX11) ||
+      key.app_controller ||
+      key.frame_style != ui::ColorProviderKey::FrameStyle::kDefault ||
+      key.contrast_mode != ui::ColorProviderKey::ContrastMode::kNormal ||
+      key.forced_colors != ui::ColorProviderKey::ForcedColors::kNone) {
+    return;
+  }
+
+  const bool dark = key.color_mode == ui::ColorProviderKey::ColorMode::kDark;
+  const SkColor frame =
+      dark ? SkColorSetRGB(0x1C, 0x29, 0x32) : SkColorSetRGB(0xE2, 0xEB, 0xF0);
+  const SkColor surface =
+      dark ? SkColorSetRGB(0x2C, 0x39, 0x42) : SkColorSetRGB(0xF5, 0xF9, 0xFB);
+  const SkColor primary =
+      dark ? SkColorSetRGB(0xF2, 0xF6, 0xF8) : SkColorSetRGB(0x21, 0x31, 0x3B);
+  const SkColor secondary =
+      dark ? SkColorSetRGB(0xC8, 0xD5, 0xDD) : SkColorSetRGB(0x46, 0x5C, 0x69);
+  const SkColor edge = dark ? SkColorSetARGB(0x66, 0x66, 0x7E, 0x8B)
+                            : SkColorSetARGB(0x80, 0xFF, 0xFF, 0xFF);
+  ui::ColorMixer& mixer = provider->AddMixer();
+  mixer[ui::kColorFrameActive] = {frame};
+  mixer[ui::kColorFrameInactive] = {frame};
+  mixer[kColorToolbar] = {surface};
+  mixer[kColorToolbarText] = {primary};
+  mixer[kColorToolbarButtonText] = {secondary};
+  mixer[kColorLocationBarBackground] = {dark ? SkColorSetRGB(0x20, 0x32, 0x3C)
+                                             : SK_ColorWHITE};
+  mixer[kColorLocationBarBackgroundHovered] = {
+      dark ? SkColorSetRGB(0x2A, 0x3B, 0x45) : SkColorSetRGB(0xF8, 0xFC, 0xFF)};
+  mixer[kColorToolbarTopSeparatorFrameActive] = {edge};
+  mixer[kColorToolbarTopSeparatorFrameInactive] = {edge};
+  mixer[kColorTabStrokeFrameActive] = {edge};
+  mixer[kColorTabStrokeFrameInactive] = {edge};
+  mixer[kColorTabBackgroundActiveFrameActive] = {surface};
+  mixer[kColorTabBackgroundActiveFrameInactive] = {surface};
+  mixer[kColorTabBackgroundInactiveFrameActive] = {frame};
+  mixer[kColorTabBackgroundInactiveFrameInactive] = {frame};
+  mixer[kColorTabForegroundActiveFrameActive] = {primary};
+  mixer[kColorTabForegroundActiveFrameInactive] = {primary};
+  mixer[kColorTabForegroundInactiveFrameActive] = {secondary};
+  mixer[kColorTabForegroundInactiveFrameInactive] = {secondary};
+}
+#endif
+
